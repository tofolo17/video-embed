# Caminhos absolutos para as pastas de entrada e saída na sua máquina
INPUT_PATH=/caminho/para/video-embed/input
OUTPUT_PATH=/caminho/para/video-embed/output

# Nome dos arquivos envolvidos (background, caption e output)
BACKGROUND_FILE=background.mp4
CAPTION_FILE=caption.mp4
OUTPUT_FILE=output.mp4

# Tamanho do vídeo de saída
SIZE=1080x1920

# Constantes, não alterar
DOCKER_INPUT=/docker/app/input
DOCKER_OUTPUT=/docker/app/output
